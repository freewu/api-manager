            {
                "name": "msg",
                "type": "String",
                "required": true,
                "desc": "返回消息",
                "example": "操作成功",
                "range": []
            },
            {
                "name": "data",
                "type": "Object",
                "required": true,
                "desc": "返回数据体",
                "example": {},
                "children": [
                    {
                        "name": "token",
                        "type": "String",
                        "required": true,
                        "desc": "访问令牌",
                        "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9",
                        "range": []
                    },
                    {
                        "name": "userId",
                        "type": "Number",
                        "required": true,
                        "desc": "用户ID",
                        "example": 10001,
                        "range": []
                    }
                ]
            }
        ],
        "mock": {
            "enable": true,
            "response": "{\n  \"code\":200,\n  \"msg\":\"操作成功\",\n  \"data\":{\n    \"token\":\"@mj(@token)\",\n    \"userId\":10001\n  }\n}"
