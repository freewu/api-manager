    {
        "id": "api_1001",
        "name": "用户登录",
        "desc": "账号密码登录接口，返回token令牌",
        "path": "/api/v1/user/login",
        "method": "POST",
        "status": 1,
        "sort": 1,
        "folder": false,
        "baseUrl": "",
        "inject": "",
        "headers": [
            {
                "name": "Content-Type",
                "value": "application/json",
                "required": true,
                "desc": "请求数据格式"
            }
        ],
        "params": [],
        "queryParams": [],
        "bodyInfo": {
            "bodyType": "raw",
            "raw": "{\n  \"username\":\"admin\",\n  \"password\":\"123456\"\n}",
            "params": [
                {
                    "name": "username",
                    "type": "String",
                    "required": true,
                    "desc": "登录账号",
                    "example": "admin",
                    "range": []
                },
                {
                    "name": "password",
                    "type": "String",
                    "required": true,
                    "desc": "登录密码",
                    "example": "123456",
                    "range": []
                }
            ]
        },
        "responseParams": [
            {
                "name": "code",
                "type": "Number",
                "required": true,
                "desc": "业务码，200成功",
                "example": 200,
                "range": []
