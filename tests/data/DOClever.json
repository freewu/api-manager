        "children": [
            {
                "id": "api_2002",
                "name": "获取用户详情",
                "desc": "根据用户ID查询用户信息，Restful路径参数",
                "path": "/api/v1/user/{userId}",
                "method": "GET",
                "status": 1,
                "sort": 1,
                "folder": false,
                "headers": [
                    {
                        "name": "Authorization",
                        "value": "Bearer {{token}}",
                        "required": true,
                        "desc": "身份令牌"
                    }
                ],
                "params": [
                    {
                        "name": "userId",
                        "type": "Number",
                        "required": true,
                        "desc": "用户编号",
                        "example": 10001,
                        "range": []
                    }
                ],
                "queryParams": [
                    {
                        "name": "includeRole",
                        "type": "Boolean",
                        "required": false,
                        "desc": "是否携带角色信息",
                        "example": true,
                        "range": []
                    }
                ],
                "bodyInfo": {
                    "bodyType": "none",
                    "raw": "",
                    "params": []
                },
                "responseParams": [
                    {
                        "name": "code",
                        "type": "Number",
                        "required": true,
                        "desc": "业务码",
                        "example": 2000
                    },
                    {
                        "name": "data",
                        "type": "Object",
                        "required": true,
                        "desc": "用户详情",
                        "children": [
                            {
                                "name": "userId",
                                "type": "Number",
                                "required": true,
                                "desc": "用户ID",
                                "example": 10001
                            },
                            {
                                "name": "nickname",
                                "type": "String",
                                "required": true,
                                "desc": "昵称",
                                "example": "张三"
                            },
                            {
                                "name": "phone",
                                "type": "String",
                                "required": false,
                                "desc": "手机号",
                                "example": "13800138000"
                            }
                        ]
                    }
                ],
                "mock": {
                    "enable": true,
                    "response": "{\n  \"code\":2000,\n  \"data\":{\"userId\":10001,\"nickname\":\"张三\",\"phone\":\"13800138000\"}\n}"
                },
                "children": []
            }
        ]
    }
