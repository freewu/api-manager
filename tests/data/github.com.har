          "content": {
            "size": 7916,
            "mimeType": "application/json",
            "text": "{\"searchWorkerFilePath\":\"/assets-cdn/worker/find-file-worker-197357bd459e1d17.js\",\"ssoOrganizations\":[],\"copilotUpsellBannerDismissed\":false,\"showCopilotSpacesMcpBanner\":true,\"previewUrl\":\"https://viewscreen.githubusercontent.com\",\"helpUrl\":\"https://docs.github.com\",\"apiURL\":\"https://api.individual.githubcopilot.com\",\"apiVersion\":\"2025-05-01\",\"currentUserLogin\":\"freewu\",\"customInstructions\":null,\"customCopilotsEnabled\":true,\"customCopilotsIndividualAccessEnabled\":true,\"personalInstructions\":null,\"reviewLab\":false,\"realIp\":null,\"scrollToTop\":false,\"icebreakers\":[{\"type\":\"functional\",\"data\":[{\"id\":\"create-bug-issue\",\"message\":\"Hi Copilot! Could you please start a draft issue for a bug? Once you've created the draft issue, if you need more information, ask me 1-2 key questions. If you also think I should upload any information or images that would help write the bug issue, let me know.\",\"titleHtml\":\"Create an issue for a bug\",\"icon\":\"issue-opened\",\"color\":\"var(--display-green-fgColor)\"},{\"id\":\"summarize-pulls\",\"message\":\"Hi Copilot! Could you help summarize a pull request? I'd like to know its purpose and the key changes made. Please include details about the problem it solves, new features or functionality introduced, any breaking changes, testing done, and documentation updates. Thank you!\",\"titleHtml\":\"Summarize a pull request\",\"icon\":\"git-pull-request\",\"color\":\"var(--display-green-fgColor)\"},{\"id\":\"code-feedback\",\"message\":\"Hi Copilot! Please review my code for best practices, readability, performance, and potential bugs. First, prompt me to provide the link to the relevant GitHub repository or file. Then, offer concrete suggestions for improvement, explain any issues you discover, and provide example corrections where appropriate.\",\"titleHtml\":\"Get code feedback\",\"icon\":\"code\",\"color\":\"var(--display-gray-fgColor)\"},{\"id\":\"next-steps-issue\",\"message\":\"Hi Copilot! Could you suggest the next actionable steps for an issue, based on either the provided issue link or a copy pasted description?\",\"titleHtml\":\"Suggest next steps for an issue\",\"icon\":\"issue-opened\",\"color\":\"var(--display-green-fgColor)\"},{\"id\":\"understand-arch-diagram\",\"message\":\"Hi Copilot! Could you please help me interpret this architecture diagram?\",\"titleHtml\":\"Interpret an architecture diagram\",\"icon\":\"eye\",\"color\":\"var(--display-purple-fgColor)\"},{\"id\":\"create-profile-readme\",\"message\":\"Hi Copilot! Please create a standout profile README for $$USERNAME$$. Ask me for any key details (such as my profession, top skills, favorite projects, or social links) that would help you personalize it.\",\"titleHtml\":\"Create a profile README for me\",\"icon\":\"rocket\",\"color\":\"var(--display-pink-fgColor)\"},{\"id\":\"my-open-pulls\",\"message\":\"Hi Copilot! Can you please find my open pull requests?\",\"titleHtml\":\"My open pull requests\",\"icon\":\"git-pull-request\",\"color\":\"var(--display-green-fgColor)\"},{\"id\":\"make-pong\",\"message\":\"Hi Copilot! Could you generate a simple Pong game utilizing HTML, CSS, and JavaScript? The player should control the left paddle with their mouse, and the right paddle should be controlled automatically by a basic AI. Make sure the game includes a bouncing ball and collision detection for paddles and walls. Please provide the code for all three components: the HTML file, the CSS file, and the JavaScript file directly within the chat window. Thanks!\",\"titleHtml\":\"Make a Pong game\",\"icon\":\"code\",\"color\":\"var(--display-gray-fgColor)\"}]},{\"type\":\"instructional\",\"data\":[]},{\"type\":\"interactional\",\"data\":[{\"id\":\"to-do-app-local-storage\",\"message\":\"Create a to-do list application with local storage functionality.\",\"titleHtml\":\"To-do list with local storage\",\"icon\":\"code\",\"color\":\"var(--display-gray-fgColor)\"},{\"id\":\"digital-clock-time-zones\",\"message\":\"Create a digital clock that displays the current time in different time zones.\",\"titleHtml\":\"A digital time zone clock\",\"icon\":\"code\",\"color\":\"var(--display-gray-fgColor)\"},{\"id\":\"weather-dashboard-app\",\"message\":\"Develop a weather dashboard that fetches data from a public weather API.\",\"titleHtml\":\"Develop a weather dashboard\",\"icon\":\"code\",\"color\":\"var(--display-gray-fgColor)\"},{\"id\":\"create-joke-generator\",\"message\":\"Create a random joke generator using an external API.\",\"titleHtml\":\"Create a joke generator\",\"icon\":\"code\",\"color\":\"var(--display-gray-fgColor)\"}]}],\"mcpPermissionGateEnabled\":false,\"spark\":{\"icebreakers\":[{\"type\":\"functional\",\"data\":[{\"id\":\"family-calendar\",\"message\":\"Create a family calendar app to keep track of family events\",\"titleHtml\":\"Family calendar\",\"icon\":\"calendar\",\"color\":\"var(--fgColor-sponsors)\"},{\"id\":\"to-do-list-app\",\"message\":\"Create a to-do list app where users can add tasks, mark them complete, and organize them into categories.\",\"titleHtml\":\"To-do list app\",\"icon\":\"checkbox\",\"color\":\"var(--fgColor-link)\"},{\"id\":\"json-to-csv-converter\",\"message\":\"Build a web app that converts JSON files to CSV format with file upload and download functionality.\",\"titleHtml\":\"JSON to CSV converter\",\"icon\":\"arrow-switch\",\"color\":\"var(--fgColor-severe)\"},{\"id\":\"board-game-score-tracker\",\"message\":\"Create an app to track scores for multiple players across different board games and save game history.\",\"titleHtml\":\"Board game score tracker\",\"icon\":\"number\",\"color\":\"var(--fgColor-done)\"},{\"id\":\"media-rating-tracker\",\"message\":\"Build an app where users can rate and review movies, books, and podcasts they've consumed.\",\"titleHtml\":\"Media rating tracker\",\"icon\":\"file-media\",\"color\":\"var(--fgColor-done)\"},{\"id\":\"meal-and-grocery-planner\",\"message\":\"Create an app for planning weekly meals and generating grocery shopping lists from those meals.\",\"titleHtml\":\"Meal and grocery planner\",\"icon\":\"book\",\"color\":\"var(--fgColor-success)\"},{\"id\":\"expense-tracking-app\",\"message\":\"Build a simple finance tracker for logging expenses, setting budgets, and viewing spending trends.\",\"titleHtml\":\"Expense tracking app\",\"icon\":\"credit-card\",\"color\":\"var(--fgColor-success)\"},{\"id\":\"habit-tracking-app\",\"message\":\"Design an app for tracking daily habits with streaks and progress visualization.\",\"titleHtml\":\"Habit tracking app\",\"icon\":\"tasklist\",\"color\":\"var(--fgColor-done)\"},{\"id\":\"workout-log-app\",\"message\":\"Create a fitness app for logging workouts and tracking exercise progress over time.\",\"titleHtml\":\"Workout log app\",\"icon\":\"goal\",\"color\":\"var(--fgColor-closed)\"},{\"id\":\"password-generator-tool\",\"message\":\"Build a tool that generates secure passwords based on user-specified criteria.\",\"titleHtml\":\"Password generator tool\",\"icon\":\"lock\",\"color\":\"var(--fgColor-severe)\"},{\"id\":\"note-taking-app\",\"message\":\"Create a simple note-taking app with markdown support and search functionality.\",\"titleHtml\":\"Note taking app\",\"icon\":\"pencil\",\"color\":\"var(--fgColor-attention)\"},{\"id\":\"time-zone-converter\",\"message\":\"Build a tool to convert times between different time zones and display multiple zones at once.\",\"titleHtml\":\"Time zone converter\",\"icon\":\"globe\",\"color\":\"var(--fgColor-link)\"},{\"id\":\"recipe-collection-app\",\"message\":\"Create an app for storing and organizing recipes with ingredient lists and cooking instructions.\",\"titleHtml\":\"Recipe collection app\",\"icon\":\"bookmark\",\"color\":\"var(--fgColor-attention)\"}]},{\"type\":\"instructional\",\"data\":[]},{\"type\":\"interactional\",\"data\":[]}]},\"copilotSpacesConfig\":{\"maxDescriptionLength\":350,\"maxGeneralInstructionsLength\":4000,\"maxContentSize\":288000,\"maxResourceCount\":300,\"userHasOrgs\":true},\"showCopilotCodingAgentPremiumRequestsBanner\":true,\"currentUser\":{\"id\":953970,\"login\":\"freewu\",\"primaryAvatarUrl\":\"https://avatars.githubusercontent.com/u/953970?v=4\"},\"deferredPayloadUrl\":\"/github-copilot/chat/deferred_payload.json\",\"agentQuotaSnapshot\":{\"percent_remaining\":0.0,\"can_start_session\":false,\"can_upgrade_plan\":true,\"copilot_plan\":\"individual\",\"is_paid_individual\":false,\"overage_permitted\":false,\"quota_reset_date\":\"2026-09-01\",\"credits_used\":0}}"
