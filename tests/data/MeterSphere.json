      "assertions": [
        {
          "assertionType": "STATUS",
          "enable": true,
          "expectValue": "200",
          "condition": "EQUALS"
        },
        {
          "assertionType": "JSON_PATH",
          "enable": true,
          "expression": "$.code",
          "expectValue": "200",
          "condition": "EQUALS"
        }
      ],
      "extractors": [
        {
          "variableName": "token",
          "extractType": "JSON_PATH",
          "expression": "$.data.token",
          "matchNumber": "1",
          "variableType": "ENVIRONMENT",
          "enable": true
        },
        {
          "variableName": "login_userId",
          "extractType": "JSON_PATH",
          "expression": "$.data.userId",
          "matchNumber": "1",
          "variableType": "TEMP",
          "enable": true
        }
      ]
    },
