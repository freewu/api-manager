  "cases": [
    {
      "id": "case‑001",
      "apiId": "api‑001",
      "name": "正常登录‑获取token",
      "priority": "P0",
      "moduleId": "mod‑1‑1",
      "description": "正确账号密码登录场景",
      "request": {
        "headers": [
          {
            "key": "Content‑Type",
            "value": "application/json",
            "enable": true
          }
        ],
        "query": [],
