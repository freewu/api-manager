{
  "name": "Enterprise Business API V2",
  "protocol": "rest",
  "basePath": "https://api.biz.example.com",
  "publicPath": "/v2",
  "privatePath": "/v2",
  "auth": {
    "oauth2": {
      "authorizationUrl": "https://auth.example.com/oauth/authorize",
      "tokenUrl": "https://auth.example.com/oauth/token",
      "scope": {
        "read:user": "读取用户信息",
        "write:user": "修改用户信息",
        "read:order": "读取订单数据",
        "write:order": "创建和修改订单"
      }
    }
  },
  "resources": {
    "User管理": {
      "description": "平台用户相关接口，需要对应oauth scope权限",
      "methods": {
        "listUsers": {
          "name": "获取用户列表",
          "description": "分页查询平台用户，支持过滤、排序；需要 read:user scope",
          "httpMethod": "GET",
          "path": "/users",
          "requiresOAuth": true,
          "parameters": {
            "page": {
              "type": "integer",
              "required": false,
              "default": 1,
              "description": "页码，从1开始"
            },
            "pageSize": {
              "type": "integer",
              "required": false,
              "default": 20,
              "description": "每页条数，最大100"
            },
            "status": {
              "type": "string",
              "required": false,
              "enum": ["active", "frozen", "deleted"],
              "description": "用户状态过滤"
            },
            "keyword": {
              "type": "string",
              "required": false,
              "description": "用户名/手机号模糊搜索"
            },
            "sort": {
              "type": "array",
              "required": false,
              "description": "排序字段，多个逗号分隔，支持createTime,updateTime"
            }
          }
        },
        "getUserById": {
          "name": "获取单个用户详情",
          "description": "根据用户ID查询用户完整信息，需要 read:user scope",
          "httpMethod": "GET",
          "path": "/users/{userId}",
          "requiresOAuth": true,
          "parameters": {
            "userId": {
              "type": "string",
              "required": true,
              "description": "用户唯一ID，路径参数"
            }
          }
        },
        "createUser": {
          "name": "新建用户",
          "description": "创建平台内部用户，需要 write:user scope；请求体为application/json",
          "httpMethod": "POST",
          "path": "/users",
          "requiresOAuth": true,
          "contentType": "application/json",
          "parameters": {
            "username": {
              "type": "string",
              "required": true,
              "description": "登录账号，不可重复，3‑32字符"
            },
            "realName": {
              "type": "string",
              "required": true,
              "description": "真实姓名"
            },
            "mobile": {
              "type": "string",
              "required": false,
              "description": "手机号码"
            },
            "roles": {
              "type": "array",
              "required": true,
              "description": "角色ID数组，至少传入一个角色"
            },
            "email": {
              "type": "string",
              "required": false,
              "description": "邮箱地址"
            }
          }
        },
        "updateUser": {
          "name": "更新用户信息",
          "description": "更新指定用户，仅传入需要修改字段；需要 write:user scope",
          "httpMethod": "PUT",
          "path": "/users/{userId}",
          "requiresOAuth": true,
          "contentType": "application/json",
          "parameters": {
            "userId": {
              "type": "string",
              "required": true,
              "description": "待更新用户ID（路径）"
            },
            "realName": {
              "type": "string",
              "required": false,
              "description": "修改真实姓名"
            },
            "status": {
              "type": "string",
              "required": false,
              "enum": ["active", "frozen"],
              "description": "修改用户状态"
            }
          }
        },
        "deleteUser": {
          "name": "删除用户",
          "description": "逻辑删除用户，不可恢复；需要 write:user scope",
          "httpMethod": "DELETE",
          "path": "/users/{userId}",
          "requiresOAuth": true,
          "parameters": {
            "userId": {
              "type": "string",
              "required": true,
              "description": "待删除用户ID"
            }
          }
        }
      }
    },
    "订单Order": {
      "description": "业务订单模块，读写分别需要不同scope",
      "methods": {
        "createOrder": {
          "name": "创建订单",
          "description": "提交业务订单，需要 write:order scope，JSON body提交订单明细",
          "httpMethod": "POST",
          "path": "/orders",
          "requiresOAuth": true,
          "contentType": "application/json",
          "parameters": {
            "customerId": {
              "type": "string",
              "required": true,
              "description": "客户ID"
            },
            "amount": {
              "type": "number",
              "required": true,
              "description": "订单总金额，单位元，保留两位小数"
            },
            "productIds": {
              "type": "array",
              "required": true,
              "description": "商品ID列表"
            },
            "remark": {
              "type": "string",
              "required": false,
              "description": "订单备注，最多500字符"
            }
          }
        },
        "getOrder": {
          "name": "查询订单",
          "description": "按订单号获取订单详情，需要 read:order scope",
          "httpMethod": "GET",
          "path": "/orders/{orderNo}",
          "requiresOAuth": true,
          "parameters": {
            "orderNo": {
              "type": "string",
              "required": true,
              "description": "业务订单编号"
            }
          }
        }
      }
    },
    "公共工具": {
      "description": "无需授权的公开接口",
      "methods": {
        "getServerTime": {
          "name": "获取服务器时间",
          "description": "获取服务端当前时间戳，用于客户端时间校对，无需鉴权",
          "httpMethod": "GET",
          "path": "/common/time",
          "requiresOAuth": false,
          "parameters": {}
        }
      }
    }
  }
}
